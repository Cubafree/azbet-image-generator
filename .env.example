# OpenAI
OPENAI_API_KEY=sk-proj-...

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Cloudinary overlay asset public_ids (set after running: npm run upload-assets)
CLOUDINARY_LOGO_PUBLIC_ID=banner-gen/logo
CLOUDINARY_BADGES_PUBLIC_ID=banner-gen/badges
# Bottom frame — one per accent color
CLOUDINARY_FRAME_CYAN_PUBLIC_ID=banner-gen/frame-cyan
CLOUDINARY_FRAME_GREEN_PUBLIC_ID=banner-gen/frame-green
CLOUDINARY_FRAME_PURPLE_PUBLIC_ID=banner-gen/frame-purple
CLOUDINARY_FRAME_GOLD_PUBLIC_ID=banner-gen/frame-gold

# Cloudinary text overlay settings (adjust to match your frame design)
CLOUDINARY_TEXT_FONT=Arial
CLOUDINARY_TEXT_SIZE=52
CLOUDINARY_TEXT_COLOR=ffffff
CLOUDINARY_TEXT_GRAVITY=south
CLOUDINARY_TEXT_Y=120

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHANNEL_ID=@your_channel_or_-100xxxxxxxxxx

# Database (Railway injects DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# App
PORT=3000
